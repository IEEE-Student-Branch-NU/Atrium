## Authorization Helper (Server-Side)

Core utility function used by every API:

```typescript
// src/utils/auth/permissions.ts

async function getUserPermissions(
  supabase, profileId, branchId
): Promise<string[]> {
  // 1. Check SuperAdmin bypass
  const { data: profile } = await supabase
    .from('profiles')
    .select('is_super_admin')
    .eq('id', profileId)
    .single()
  
  if (profile?.is_super_admin) return ['*'] // all permissions

  // 2. Get position-based permissions
  const { data: posPerms } = await supabase
    .from('memberships')
    .select(`
      positions!inner (
        position_permissions!inner (
          permissions!inner ( name )
        )
      )
    `)
    .eq('profile_id', profileId)
    .eq('branch_id', branchId)
    .is('ended_at', null)

  // 3. Get direct grants
  const { data: directPerms } = await supabase
    .from('member_permissions')
    .select('permissions!inner ( name )')
    .eq('profile_id', profileId)
    .eq('branch_id', branchId)
    .is('revoked_at', null)

  // 4. Union and deduplicate
  return [...new Set([...posPerms, ...directPerms])]
}

function hasPermission(perms: string[], required: string): boolean {
  return perms.includes('*') || perms.includes(required)
}
```

